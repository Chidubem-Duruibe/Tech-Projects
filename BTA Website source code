<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Business Technology Association | Kennesaw State University</title>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#0B1F4B;
    --navy-deep:#071433;
    --navy-mid:#13306E;
    --yellow:#FFC72C;
    --yellow-soft:#FFD96A;
    --white:#FFFFFF;
    --ink:#0B1F4B;
    --line: rgba(255,255,255,0.16);
    --maxw: 1180px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth; scroll-padding-top:80px;}
  body{
    margin:0; background:var(--navy); color:var(--white);
    font-family:'IBM Plex Sans', sans-serif; -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.mono{font-family:'IBM Plex Mono', monospace;}
  a{color:inherit;}
  .wrap{max-width:var(--maxw); margin:0 auto; padding:0 32px;}
  :focus-visible{outline:2px solid var(--yellow); outline-offset:3px;}

  /* ---------- NAV ---------- */
  header{
    position:sticky; top:0; z-index:50;
    background:rgba(11,31,75,0.92); backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  nav.wrap{display:flex; align-items:center; justify-content:space-between; height:80px; position:relative;}
  .brand{display:flex; align-items:center; gap:12px; font-weight:700; letter-spacing:0.02em; font-size:15px; text-decoration:none;}
  .brand img.logo{height:52px; width:auto; display:block;}
  .brand .mark{
    width:40px; height:40px; border-radius:6px; background:var(--yellow); color:var(--navy);
    display:none; align-items:center; justify-content:center; font-family:'IBM Plex Mono'; font-weight:700; font-size:15px;
  }
  .brand .name{opacity:.8; font-weight:400; font-size:13px;}
  .navlinks{display:flex; gap:34px; font-size:13px; letter-spacing:0.06em; text-transform:uppercase;}
  .navlinks a{text-decoration:none; opacity:0.8; transition:opacity .2s, color .2s;}
  .navlinks a:hover{opacity:1; color:var(--yellow);}
  .menu-btn{display:none; background:none; border:1px solid var(--line); color:var(--white); width:42px; height:42px; border-radius:6px; cursor:pointer; font-size:20px;}

  .btn{
    display:inline-flex; align-items:center; gap:8px;
    background:var(--yellow); color:var(--navy-deep);
    padding:12px 22px; border-radius:3px; border:1px solid var(--yellow);
    font-family:'IBM Plex Mono', monospace; font-weight:600; font-size:13px; letter-spacing:0.03em;
    text-decoration:none; transition:transform .15s ease, background .15s ease;
  }
  .btn:hover{background:var(--yellow-soft); transform:translateY(-1px);}
  .btn.ghost{background:transparent; color:var(--white); border:1px solid rgba(255,255,255,0.4);}
  .btn.ghost:hover{border-color:var(--yellow); color:var(--yellow);}
  .btn.dark{background:var(--navy); color:var(--white); border-color:var(--navy);}
  .btn.dark:hover{background:var(--navy-deep);}

  /* ---------- HERO ---------- */
  .hero{position:relative; padding:100px 0 90px; overflow:hidden; border-bottom:1px solid var(--line);}
  .hero-grid{display:grid; grid-template-columns:1.1fr 0.9fr; gap:50px; align-items:center;}
  .eyebrow{
    display:inline-flex; align-items:center; gap:10px;
    font-size:12px; letter-spacing:0.14em; text-transform:uppercase;
    color:var(--yellow); margin-bottom:20px; font-family:'IBM Plex Mono';
  }
  .eyebrow::before{content:""; width:22px; height:2px; background:var(--yellow);}
  h1.title{font-size:clamp(38px,5.2vw,64px); line-height:1.04; font-weight:700; margin:0 0 22px; letter-spacing:-0.01em;}
  h1.title .accent{color:var(--yellow);}
  .lede{font-size:18px; line-height:1.6; color:rgba(255,255,255,0.82); max-width:46ch; margin:0 0 34px;}
  .hero-ctas{display:flex; gap:14px; flex-wrap:wrap;}
  .hero-stats{display:flex; margin-top:48px; border-top:1px solid var(--line);}
  .stat{flex:1; padding:18px 20px 0 0; border-right:1px solid var(--line);}
  .stat + .stat{padding-left:20px;}
  .stat:last-child{border-right:none;}
  .stat b{display:block; font-family:'IBM Plex Mono'; font-size:28px; color:var(--yellow);}
  .stat span{font-size:12.5px; color:rgba(255,255,255,0.7); letter-spacing:0.03em;}

  /* signature trace-to-ledger graphic */
  .trace-wrap{position:relative; aspect-ratio:1/1; max-width:480px; margin:0 auto; width:100%;}
  svg.trace{width:100%; height:100%; display:block;}
  .trace-line{fill:none; stroke:var(--yellow); stroke-width:2.5; stroke-dasharray:900; stroke-dashoffset:900; animation:draw 2.6s ease forwards .3s;}
  .trace-line.b{stroke:var(--white); animation-delay:.6s;}
  .ledger-line{stroke:rgba(255,255,255,0.35); stroke-width:1; opacity:0; animation:fadein 1s ease forwards 2.2s;}
  .node{fill:var(--yellow); opacity:0; animation:fadein .5s ease forwards;}
  @keyframes draw{to{stroke-dashoffset:0;}}
  @keyframes fadein{to{opacity:1;}}
  @media (prefers-reduced-motion: reduce){
    .trace-line,.ledger-line,.node{animation:none !important; stroke-dashoffset:0 !important; opacity:1 !important;}
    .reveal{transition:none !important; opacity:1 !important; transform:none !important;}
    html{scroll-behavior:auto;}
  }

  .divider{height:56px; width:100%; background:repeating-linear-gradient(90deg, transparent 0 46px, var(--line) 46px 47px); position:relative;}
  .divider::after{content:""; position:absolute; left:0; top:50%; width:100%; height:1px; background:var(--line);}

  section{padding:90px 0;}
  .section-head{max-width:640px; margin-bottom:52px;}
  .section-head h2{font-size:clamp(28px,3.4vw,40px); margin:0 0 14px; font-weight:700; letter-spacing:-0.01em;}
  .section-head p{font-size:16px; color:rgba(255,255,255,0.78); line-height:1.65; margin:0;}

  /* ---------- ABOUT ---------- */
  #about{background:var(--navy-deep);}
  .about-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); border:1px solid var(--line);}
  .about-card{background:var(--navy-deep); padding:32px;}
  .about-card .idx{font-family:'IBM Plex Mono'; font-size:12px; color:var(--yellow); letter-spacing:0.08em; margin-bottom:16px; display:block;}
  .about-card h3{font-size:18px; margin:0 0 10px;}
  .about-card p{font-size:14.5px; line-height:1.6; color:rgba(255,255,255,0.75); margin:0;}

  /* ---------- BOARD ---------- */
  .board{background:var(--white); color:var(--ink);}
  .board .eyebrow{color:var(--navy);}
  .board .eyebrow::before{background:var(--yellow); height:4px;}
  .board .section-head p{color:rgba(11,31,75,0.75);}
  .board-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:22px;}
  .card{background:var(--navy); border-radius:4px; overflow:hidden; border-bottom:4px solid var(--yellow); display:flex; flex-direction:column;}
  .card-top{padding:22px 22px 26px; position:relative; flex:1;}
  .card-top::before{content:""; position:absolute; top:16px; right:16px; width:24px; height:24px; border-top:2px solid var(--yellow); border-right:2px solid var(--yellow);}
  .card-tag{font-family:'IBM Plex Mono'; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:var(--yellow); padding-right:34px;}
  .avatar{
    width:84px; height:84px; border-radius:50%; margin-top:18px; overflow:hidden;
    background:var(--yellow); color:var(--navy);
    display:flex; align-items:center; justify-content:center;
    font-family:'IBM Plex Mono'; font-weight:700; font-size:24px;
  }
  .avatar img{width:100%; height:100%; object-fit:cover; display:block;}
  .card-name{color:var(--white); font-size:18px; font-weight:600; margin:16px 0 4px; line-height:1.25;}
  .card-role{color:rgba(255,255,255,0.75); font-size:13px; font-family:'IBM Plex Mono';}


  .card{background:var(--navy); border-radius:4px; overflow:hidden; border-bottom:4px solid var(--yellow); display:flex; flex-direction:column;}
  .photo{position:relative; aspect-ratio:4/5; background:var(--yellow); overflow:hidden;}
  .photo .initials{position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-family:'IBM Plex Mono'; font-weight:700; font-size:56px; color:var(--navy);}
  .photo img{position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:50% 20%; display:block;}
  .card-info{padding:18px 20px 22px; flex:1;}
  .card-info .card-name{margin-top:8px;}

  /* ---------- EVENTS CALENDAR ---------- */
  #events{background:var(--navy);}
  .cal-layout{display:grid; grid-template-columns:1.5fr 1fr; gap:36px; align-items:start;}
  .cal{background:var(--navy-deep); border:1px solid var(--line); border-radius:4px;}
  .cal-head{display:flex; align-items:center; justify-content:space-between; padding:18px 20px; border-bottom:1px solid var(--line);}
  .cal-head h3{margin:0; font-size:18px; letter-spacing:0.02em;}
  .cal-nav{display:flex; gap:8px;}
  .cal-nav button{
    background:transparent; color:var(--white); border:1px solid rgba(255,255,255,0.35);
    width:36px; height:36px; border-radius:3px; cursor:pointer; font-size:16px; font-family:'IBM Plex Mono';
  }
  .cal-nav button:hover:not(:disabled){border-color:var(--yellow); color:var(--yellow);}
  .cal-nav button:disabled{opacity:.3; cursor:not-allowed;}
  .cal-dow{display:grid; grid-template-columns:repeat(7,1fr); border-bottom:1px solid var(--line);}
  .cal-dow div{padding:10px 8px; font-family:'IBM Plex Mono'; font-size:11px; letter-spacing:0.08em; text-transform:uppercase; color:rgba(255,255,255,0.6); text-align:left;}
  .cal-grid{display:grid; grid-template-columns:repeat(7,1fr);}
  .cell{min-height:96px; padding:8px; border-right:1px solid var(--line); border-bottom:1px solid var(--line); display:flex; flex-direction:column; gap:5px; min-width:0;}
  .cell:nth-child(7n){border-right:none;}
  .cell.empty{background:rgba(255,255,255,0.025);}
  .cell .num{font-family:'IBM Plex Mono'; font-size:12px; color:rgba(255,255,255,0.7);}
  .cell.today{box-shadow:inset 0 0 0 2px var(--yellow);}
  .cell.today .num{color:var(--yellow); font-weight:700;}
  .chip{
    display:block; background:var(--yellow); color:var(--navy-deep); font-size:11px; font-weight:600; line-height:1.25;
    padding:4px 6px; border-radius:2px; text-decoration:none; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  }
  .chip:hover{background:var(--yellow-soft);}
  .chip.past{background:rgba(255,255,255,0.22); color:rgba(255,255,255,0.85);}

  .ev-list{display:flex; flex-direction:column; gap:14px;}
  .ev-list h3{margin:0 0 4px; font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:var(--yellow);}
  .ev{
    background:var(--navy-deep); border:1px solid var(--line); border-left:4px solid var(--yellow);
    padding:16px 18px; border-radius:3px; transition:background .3s;
  }
  .ev.past{border-left-color:rgba(255,255,255,0.3); opacity:.7;}
  .ev.flash{background:var(--navy-mid);}
  .ev-top{display:flex; justify-content:space-between; gap:10px; align-items:center; margin-bottom:6px;}
  .ev-date{font-family:'IBM Plex Mono'; font-size:12px; color:var(--yellow); letter-spacing:0.04em;}
  .ev.past .ev-date{color:rgba(255,255,255,0.65);}
  .tag{font-family:'IBM Plex Mono'; font-size:10px; letter-spacing:0.1em; text-transform:uppercase; padding:3px 7px; border-radius:2px; border:1px solid rgba(255,255,255,0.35); color:rgba(255,255,255,0.85);}
  .tag.up{background:var(--yellow); color:var(--navy-deep); border-color:var(--yellow); font-weight:600;}
  .ev h4{margin:0 0 6px; font-size:16px; font-weight:600;}
  .ev .meta{font-size:13px; color:rgba(255,255,255,0.75); line-height:1.55;}

  /* ---------- JOIN ---------- */
  .cta-band{background:var(--yellow); color:var(--navy-deep); text-align:center; padding:84px 0;}
  .cta-band .eyebrow{color:var(--navy-deep); justify-content:center;}
  .cta-band .eyebrow::before{background:var(--navy-deep);}
  .cta-band h2{font-size:clamp(26px,4vw,42px); margin:0 0 16px;}
  .cta-band p{color:rgba(7,20,51,0.82); font-size:16px; margin:0 0 30px;}

  /* ---------- FOOTER ---------- */
  footer{padding:48px 0; background:var(--navy-deep);}
  .foot-grid{display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:24px;}
  .foot-links{display:flex; gap:28px; font-size:13px; flex-wrap:wrap;}
  .foot-links a{text-decoration:none; opacity:0.8;}
  .foot-links a:hover{opacity:1; color:var(--yellow);}
  .foot-note{font-size:12px; color:rgba(255,255,255,0.55); margin-top:28px;}

  .reveal{opacity:0; transform:translateY(18px); transition:opacity .6s ease, transform .6s ease;}
  .reveal.in{opacity:1; transform:none;}

  @media (max-width:980px){
    .board-grid{grid-template-columns:repeat(3,1fr);}
    .cal-layout{grid-template-columns:1fr;}
  }
  @media (max-width:880px){
    .hero-grid{grid-template-columns:1fr;}
    .trace-wrap{max-width:320px;}
    .about-grid{grid-template-columns:1fr;}
    .board-grid{grid-template-columns:1fr 1fr;}
    .menu-btn{display:block;}
    .navlinks{
      display:none; position:absolute; top:80px; left:0; right:0; flex-direction:column; gap:0;
      background:var(--navy-deep); border-bottom:1px solid var(--line);
    }
    .navlinks.open{display:flex;}
    .navlinks a{padding:16px 32px; border-top:1px solid var(--line);}
    .brand .name{display:none;}
  }
  @media (max-width:640px){
    .wrap{padding:0 20px;}
    .board-grid{grid-template-columns:1fr;}
    .hero-stats{flex-direction:column;}
    .stat,.stat + .stat{border-right:none; border-bottom:1px solid var(--line); padding:14px 0; }
    .stat:last-child{border-bottom:none;}
    .cell{min-height:64px; padding:5px;}
    .chip{font-size:0; padding:0; height:6px; width:100%; border-radius:3px;}
    .cal-dow div{padding:8px 4px; font-size:10px;}
  }
</style>
</head>
