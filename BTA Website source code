<script>
  // ---------- Events data (edit here to add or change events) ----------
  // date: YYYY-MM-DD, start/end: 24-hour HH:MM
  const EVENTS = [
    { name:"Involvement Fair",                     type:"Fair",           date:"2026-09-15", start:"11:00", end:"14:00", location:"Marietta Campus" },
    { name:"Involvement Fair",                     type:"Fair",           date:"2026-09-21", start:"11:00", end:"14:00", location:"Campus Green" },
    { name:"First General Body Meeting",           type:"Meeting",        date:"2026-09-23", start:"18:00", end:"19:00", location:"3D Printing Lab" },
    { name:"Resume and LinkedIn Workshop",         type:"Workshop",       date:"2026-09-29", start:"18:00", end:"19:00", location:"Location to be announced" },
    { name:"InformData Executive Speaker Series",  type:"Speaker Series", date:"2026-10-15", start:"14:00", end:"15:00", location:"English Building 203" },
    { name:"Equifax Company Speaker Series",       type:"Speaker Series", date:"2026-10-21", start:"18:00", end:"19:00", location:"ALC 2109" }
  ].map((e,i)=>({...e, id:"ev-"+i}));

  const MONTHS = ["January","February","March","April","May","June","July","August","September","October","November","December"];
  const DAYS = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
  const SHORT_MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];

  const toDate = (d,t)=>new Date(d+"T"+t+":00");
  const fmtTime = t=>{ let [h,m]=t.split(":").map(Number); const ap=h>=12?"PM":"AM"; h=h%12||12; return h+":"+String(m).padStart(2,"0")+" "+ap; };
  const ymd = d=>d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");
  const now = new Date();
  const isPast = e => toDate(e.date, e.end) < now;

  // ---------- Month range driven by the events ----------
  const dates = EVENTS.map(e=>toDate(e.date,"00:00"));
  const minD = new Date(Math.min(...dates)), maxD = new Date(Math.max(...dates));
  const minIdx = minD.getFullYear()*12 + minD.getMonth();
  const maxIdx = maxD.getFullYear()*12 + maxD.getMonth();
  const nowIdx = now.getFullYear()*12 + now.getMonth();
  let cur = Math.min(Math.max(nowIdx, minIdx), maxIdx);

  const grid = document.getElementById("calGrid");
  const title = document.getElementById("calTitle");
  const prevB = document.getElementById("prevMonth");
  const nextB = document.getElementById("nextMonth");

  function renderCal(){
    const year = Math.floor(cur/12), month = cur%12;
    title.textContent = MONTHS[month]+" "+year;
    prevB.disabled = cur<=minIdx; nextB.disabled = cur>=maxIdx;
    const first = new Date(year, month, 1).getDay();
    const total = new Date(year, month+1, 0).getDate();
    const todayStr = ymd(now);
    let html = "";
    for(let i=0;i<first;i++) html += '<div class="cell empty"></div>';
    for(let d=1; d<=total; d++){
      const ds = year+"-"+String(month+1).padStart(2,"0")+"-"+String(d).padStart(2,"0");
      const evs = EVENTS.filter(e=>e.date===ds);
      const chips = evs.map(e=>'<a class="chip'+(isPast(e)?' past':'')+'" href="#'+e.id+'" data-ev="'+e.id+'" title="'+e.name+', '+fmtTime(e.start)+'">'+e.name+'</a>').join("");
      html += '<div class="cell'+(ds===todayStr?' today':'')+'"><span class="num">'+d+'</span>'+chips+'</div>';
    }
    const rem = (7 - (first+total)%7)%7;
    for(let i=0;i<rem;i++) html += '<div class="cell empty"></div>';
    grid.innerHTML = html;
  }
  prevB.onclick = ()=>{ if(cur>minIdx){cur--; renderCal();} };
  nextB.onclick = ()=>{ if(cur<maxIdx){cur++; renderCal();} };

  // ---------- Event list ----------
  const list = document.getElementById("evList");
  EVENTS.slice().sort((a,b)=>toDate(a.date,a.start)-toDate(b.date,b.start)).forEach(e=>{
    const d = toDate(e.date,"00:00");
    const past = isPast(e);
    const el = document.createElement("div");
    el.className = "ev"+(past?" past":"");
    el.id = e.id;
    el.innerHTML =
      '<div class="ev-top"><span class="ev-date">'+DAYS[d.getDay()].toUpperCase().slice(0,3)+', '+SHORT_MONTHS[d.getMonth()].toUpperCase()+' '+d.getDate()+'</span>'+
      '<span class="tag'+(past?'':' up')+'">'+(past?'Past':'Upcoming')+'</span></div>'+
      '<h4>'+e.name+'</h4>'+
      '<div class="meta">'+DAYS[d.getDay()]+', '+MONTHS[d.getMonth()]+' '+d.getDate()+'<br>'+fmtTime(e.start)+' – '+fmtTime(e.end)+'<br>'+e.location+'</div>';
    list.appendChild(el);
  });

  // chip click: jump to details and flash
  grid.addEventListener("click", ev=>{
    const a = ev.target.closest("[data-ev]");
    if(!a) return;
    ev.preventDefault();
    const t = document.getElementById(a.dataset.ev);
    t.scrollIntoView({behavior:"smooth", block:"center"});
    t.classList.add("flash"); setTimeout(()=>t.classList.remove("flash"), 1400);
  });

  renderCal();

  // ---------- Mobile menu ----------
  const menuBtn = document.getElementById("menuBtn"), navlinks = document.getElementById("navlinks");
  menuBtn.addEventListener("click", ()=>{
    const open = navlinks.classList.toggle("open");
    menuBtn.setAttribute("aria-expanded", open);
  });
  navlinks.querySelectorAll("a").forEach(a=>a.addEventListener("click", ()=>{ navlinks.classList.remove("open"); menuBtn.setAttribute("aria-expanded","false"); }));

  // ---------- Reveal on scroll ----------
  const io = new IntersectionObserver(entries=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add("in"); io.unobserve(e.target); } });
  }, {threshold:0.12});
  document.querySelectorAll(".reveal").forEach(el=>io.observe(el));
</script>

